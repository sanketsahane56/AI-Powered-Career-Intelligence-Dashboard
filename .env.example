# CareerIQ - Environment Variables Template
# Copy this file to .env and configure your values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Default is SQLite local file: data/careeriq.db
DATABASE_PATH=data/careeriq.db

# Storage Directories
UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports
MAX_CONTENT_LENGTH=10485760 # 10MB upload limit

# Optional AI Enhancement (Optional: Core features work 100% offline without any API key)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
